{
  "name": "ledger-lite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private-by-default, self-hosted shared family ledger starter for two adults",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute ledger-lite-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute ledger-lite-db --remote --file=./schema.sql",
    "user:add": "node scripts/add-user.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.92.0"
  },
  "engines": {"node": ">=22.13.0"}
}
